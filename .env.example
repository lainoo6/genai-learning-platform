# Local PostgreSQL (see docs/plan/03_local-mode-and-launch.md); switch to Neon on launch day.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genai_learning

# Auth.js session secret. Generate one with: npx auth secret
AUTH_SECRET=

# LLM provider key used by src/lib/llm (Vercel AI SDK + OpenAI provider).
# Leave it empty to run in mock mode; the app never breaks without a key.
OPENAI_API_KEY=
# Alternative key listed in docs/plan/01 §7. Not wired up yet — the service
# layer currently talks to OpenAI only.
ANTHROPIC_API_KEY=

# Optional. Overrides the default model (default: gpt-4o-mini).
LLM_MODEL=

# Set to true to force mock mode (demo safe fallback).
LLM_MOCK=

# Public app URL. Replace with the Vercel URL on launch day.
NEXT_PUBLIC_APP_URL=http://localhost:3000
