# Local PostgreSQL (see docs/plan/03_local-mode-and-launch.md); switch to Neon on launch day.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genai_learning

# Auth.js session secret. Generate one with: npx auth secret
AUTH_SECRET=

# LLM gateway used by src/lib/llm (Vercel AI SDK). Any OpenAI-compatible
# endpoint works, e.g. https://openrouter.ai/api/v1. Leave LLM_API_KEY empty to
# run in mock mode; the app never breaks without a key.
LLM_API_KEY=
LLM_BASE_URL=

# Model id passed straight to the gateway (default: gpt-4o-mini).
LLM_MODEL=

# Set to true to force mock mode (demo safe fallback).
LLM_MOCK=

# GitHub token used by repo-to-course analysis (src/lib/github-repo.ts).
# Optional for public repositories — unauthenticated requests are limited to
# 60/hour. A classic token with no scopes is enough for public repos; private
# repos need the `repo` scope. Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Public app URL. Replace with the Vercel URL on launch day.
NEXT_PUBLIC_APP_URL=http://localhost:3000
